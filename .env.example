# Postgres role with SELECT on sales_dash.* and INSERT/UPDATE on sales_dash.targets
# (transaction pooler, port 6543; URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgresql://dashboard_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Login sessions: long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=

# Admin (can edit targets) and viewer (read-only). Hash a password with: node scripts/hash-password.cjs "password"
ADMIN_EMAIL=admin@isaac-wellness.com
ADMIN_NAME=Aditya Bhat
ADMIN_PASSWORD_HASH=
VIEWER_EMAIL=viewer@isaac-wellness.com
VIEWER_NAME=Viewer
VIEWER_PASSWORD_HASH=

# "off" = corrected logic; anything else = reproduce Google Sheet quirks (default)
SHEET_COMPAT=
